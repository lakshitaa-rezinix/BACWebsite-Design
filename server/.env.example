# Copy to .env and fill in real values. Never commit .env — it is gitignored.

# MongoDB connection string.
# IMPORTANT: percent-encode any of  : / ? # [ ] @  appearing in the username or
# password. An un-encoded '@' in the password is NOT an error — the driver
# silently treats the text after it as the hostname and the connection fails
# against a host that does not exist. Encode '@' as %40.
#
# When using MONGO_INITDB_ROOT_USERNAME / _PASSWORD credentials, those users live
# in the 'admin' database, so authSource=admin is required or auth will fail.
MONGODB_URI=mongodb://<user>:<percent-encoded-password>@<host>:27017/bac-site?authSource=admin

# Comma-separated list of origins allowed to call the API. Behind the nginx
# config the site is same-origin so this is belt-and-braces, but leaving it unset
# in production means any website could call your API from a visitor's browser.
CORS_ORIGIN=https://bombayassay.com,https://www.bombayassay.com

# Port the API server listens on.
PORT=5055

# Secret used to sign admin JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-secret>
